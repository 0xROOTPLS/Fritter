# Compiled binaries produced by `make`.
# Leading slash anchors to repo root, a bare `exe2h` would also match the
# loader/exe2h/ SOURCE directory, since patterns without a slash match at any depth.
/fritter
/fritter.exe
/exe2h
/exe2h.exe
/gen_poly
/gen_poly.exe
/gen_api_shuffle
/gen_api_shuffle.exe

# Intermediate Windows builds (loader + shim PE before exe2h extraction)
loader_peb1.exe
loader_peb2.exe
veh_shim.exe
dispatch_shim.exe

# exe2h-extracted blobs (regenerated each build, embedded into fritter.c)
loader_peb1_exe_x64.h
loader_peb1_exe_x64.go
loader_peb2_exe_x64.h
loader_peb2_exe_x64.go
veh_shim_exe_x64.h
veh_shim_exe_x64.go
dispatch_shim_exe_x64.h
dispatch_shim_exe_x64.go

# exe2h-emitted companion tables for function-granular dispatch
loader_peb1_fn_table_x64.h
loader_peb1_ref_table_x64.h
loader_peb2_fn_table_x64.h
loader_peb2_ref_table_x64.h
dispatch_shim_fn_table_x64.h
dispatch_shim_ref_table_x64.h

# Per-build polymorphism artifacts (generated by gen_poly / gen_api_shuffle)
include/poly_seed.h
include/api_shuffle.h

# Generated shellcode / blob outputs (smoke tests, packer output, linux loader).
# test/calc.exe and test/inject_local64.exe are deliberate test fixtures, see README.
*.bin

# DLL build target (Makefile.msvc `dll`), lib/fritter.h is source, the rest are outputs
lib/fritter.dll
lib/fritter.exp

# Object files
*.o
*.obj
*.a
*.lib

# Keep the precompiled aPLib static libs that are part of the source tree
!lib/aplib*.a
!lib/aplib*.lib

# Release artifact directory (Makefile.linux `release` target)
dist/

# Design prototype build artifacts
docs/design/prototype/*.exe
docs/design/prototype/*.obj

# Internal audit reports, kept on disk, deliberately never entered into git
# history so the decision to publish them stays open.
Review/

# Editor / OS detritus
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/
*.suo
*.user

# Agent session state
.claude/scheduled_tasks.lock

# Build logs
*.log
